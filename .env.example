# The fake IBM i's settings: where it listens and who can sign on. Copy this file to .env and
# change what you need.
#
# Every server signs on against the users, which the fake keeps in its database (the table
# QFAKE_USER). The three users below are put in the table at each start, as written here; any
# other user in the table (System Options on the 5250 main menu maintains them) is kept as it is. A password changed
# through any server holds for all of them, and stays until the next start sets these three again.
#
# The fake reads .env from the directory it starts in (or the file --env-file names). With Docker,
# pass it with --env-file .env. Variables set in the environment win over the file.
#
# Write values as they are, without quotes: Docker keeps quotes as part of the value.
# A user name is 1 to 10 characters: letters, digits, #, $, @ and _, not starting with a digit.
# Passwords are case-sensitive at password level 2 (the default). The 5250 sign-on screen takes
# up to 27 characters; the host servers take up to 128.

# ---- Where it listens ----
#
# The command line wins over these (--bind, --port, --print-port ...). A blank port, or a line
# left out or commented, means that server doesn't run. Docker's image sets its own addresses and
# ports on its command line, so these don't change them there: publish the ports with -p.

# The address to listen on: 127.0.0.1 for this machine only, 0.0.0.0 for every interface.
FAKE_IBMI_BIND=127.0.0.1

# 5250 Telnet, Network Print, sign-on, remote command and the port mapper, on IBM's own ports.
# The mapper's 449 and Telnet's TLS 992 are below 1024: outside Docker they need root or
# CAP_NET_BIND_SERVICE, so they're blank here, which leaves them off. Set them to 449 and 992
# when you can (clients that find the other ports through the mapper only look for it on 449).
FAKE_IBMI_PORT=2323
FAKE_IBMI_PRINT_PORT=8474
FAKE_IBMI_SIGNON_PORT=8476
FAKE_IBMI_COMMAND_PORT=8475
FAKE_IBMI_MAPPER_PORT=

# The same servers over TLS. The certificate is made for each run, or, with FAKE_IBMI_TLS_CERT,
# kept in that PKCS #12 file (made when it's missing, with a .crt next to it for clients to
# trust). FAKE_IBMI_TLS_NAMES adds names or addresses to a certificate it makes, comma-separated.
FAKE_IBMI_TLS_PORT=
FAKE_IBMI_PRINT_TLS_PORT=9474
FAKE_IBMI_SIGNON_TLS_PORT=9476
FAKE_IBMI_COMMAND_TLS_PORT=9475
FAKE_IBMI_TLS_CERT=
FAKE_IBMI_TLS_NAMES=

# ---- Libraries ----
#
# Each library is a SQLite database of its own: a file in FAKE_IBMI_DATABASE_DIR (QGPL.db, MYLIB.db ...),
# made when it's missing, with the library's source members, programs, display files and tables. QGPL's
# also holds the users and the spooled files. Blank keeps them in memory, gone when the fake stops.
FAKE_IBMI_DATABASE_DIR=./data

# A folder of source, read at start-up: a folder for each library (MYLIB/QRPGLESRC/prog.rpgle, or
# MYLIB/prog.rpgle for the type's usual source file), and files directly in it go to QGPL. A library
# folder that isn't a library yet makes one. Each member that's new or changed is saved, checked and
# created. It has to exist; blank reads no source.
FAKE_IBMI_SOURCE_DIR=./source

# ---- Users ----

# The user that signs on normally.
FAKE_IBMI_USER=PRTUSER
FAKE_IBMI_PASSWORD=Secret12

# A user whose password has expired. The right password gets "password has expired": the 5250
# sign-on screen goes on to a Change Password screen, and the sign-on server answers 0003000D
# until the password is changed through it.
FAKE_IBMI_EXPIRED_USER=EXPUSER
FAKE_IBMI_EXPIRED_PASSWORD=Expired1

# A user whose profile is disabled, as after too many wrong passwords. It can't sign on with
# any password: the 5250 sign-on screen says "User profile LOCKUSER cannot sign on", and the
# sign-on server answers 00020002.
FAKE_IBMI_LOCKED_USER=LOCKUSER
FAKE_IBMI_LOCKED_PASSWORD=Locked12
